# ── Region ────────────────────────────────────────────────────────────────────
# Set to AU, UK, or NZ in each Vercel project's environment variables
NEXT_PUBLIC_REGION=AU

# ── Sanity ────────────────────────────────────────────────────────────────────
# Get these from sanity.io after creating your project
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=your-read-token

# ── ISR Revalidation ──────────────────────────────────────────────────────────
# Random secret — must match the Sanity webhook configuration
SANITY_REVALIDATE_SECRET=your-random-secret-here

# ── Allstar Psychics ─────────────────────────────────────────────────────────
# Provided by Allstar Psychics Ltd — server-side only (never exposed to browser)
ALLSTAR_READERS_ENDPOINT=https://api.allstarpsychics.co.uk/readers
ALLSTAR_API_KEY=your-allstar-api-key

# ── Analytics (optional) ─────────────────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
